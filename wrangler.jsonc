{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tic-tac-toe-ultra",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  // Said out loud, because wrangler turns the workers.dev address off for a Worker with `routes`,
  // and the deploy of production adds the domain as one: installed apps live on that address.
  "workers_dev": true,
  // The app is the static files of `pnpm build`; the Worker answers /api/* and the pages of the
  // app, the rest goes to the files, with the page itself for any address the app handles in the
  // browser.
  // Three Durable Object classes, all with SQLite storage, which the free plan has too: a room of
  // the game, the archive, one object that keeps the finished games of all rooms, and a house,
  // where the family meets (docs/architecture/house.md).
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "ARCHIVE", "class_name": "Archive" },
      { "name": "HOUSE", "class_name": "House" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Archive"] },
    { "tag": "v3", "new_sqlite_classes": ["House"] },
  ],
  // The Worker also answers the pages of the app (PAGE_PATHS in server/page.ts), to put the full
  // address of the picture of a link in them; page.test.ts keeps the two lists equal.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/samen",
      "/spellen",
      "/statistieken",
      "/instellingen",
      "/spel/*",
      "/kamer/*",
      "/huis/*",
    ],
  },
}
