/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'none'

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# The pictures have fixed names, so they are kept for a day and not for a year: a new icon
# (pnpm icons) reaches people tomorrow.
/icon.svg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400

# The service worker is looked up again every time, so that a new version is found the day it is
# deployed; the offline page is the worker's own copy and may be old for a moment.
/sw.js
  Cache-Control: no-cache
/offline.html
  Cache-Control: no-cache
